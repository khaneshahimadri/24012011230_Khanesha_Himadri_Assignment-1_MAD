<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A14"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="28dp"
        android:paddingEnd="18dp"
        android:paddingBottom="25dp">

        <!-- ================= HEADER ================= -->

        <TextView
            android:id="@+id/btnDashboard"
            android:layout_width="100dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_control_small_button"
            android:gravity="center"
            android:text="‹  Dashboard"
            android:textColor="#C6D1E3"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvControlTitle"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:gravity="center_vertical"
            android:text="⚙  BEACON CONTROL"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/btnDashboard" />


        <!-- ================= BEACON ENGINE ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardEngine"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#0D1729"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnDashboard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvEngineLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEACON ENGINE"
                    android:textColor="#A8B6CD"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvRunning"
                    android:layout_width="72dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_running_badge"
                    android:gravity="center"
                    android:text="RUNNING"
                    android:textColor="#00E5AE"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="@id/tvEngineLabel"
                    app:layout_constraintStart_toEndOf="@id/tvEngineLabel"
                    app:layout_constraintTop_toTopOf="@id/tvEngineLabel" />

                <TextView
                    android:id="@+id/tvDaemon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Daemon Active &amp; Listening"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/btnPower"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEngineLabel" />

                <TextView
                    android:id="@+id/tvDaemonInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Monitors incoming SMS messages in the background with zero data usage."
                    android:textColor="#94A1B6"
                    android:textSize="12sp"
                    app:layout_constraintEnd_toStartOf="@id/btnPower"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDaemon" />

                <TextView
                    android:id="@+id/btnPower"
                    android:layout_width="58dp"
                    android:layout_height="70dp"
                    android:background="@drawable/bg_power_on"
                    android:gravity="center"
                    android:text="⏻"
                    android:textColor="#031510"
                    android:textSize="35sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvDaemon" />

                <View
                    android:id="@+id/dividerEngine"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="18dp"
                    android:background="#1E2B40"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvDaemonInfo" />

                <TextView
                    android:id="@+id/tvHook"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="●   SMS Hook: Android BroadcastReceiver"
                    android:textColor="#9AA9BF"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toStartOf="@id/tvPort"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/dividerEngine" />

                <TextView
                    android:id="@+id/tvPort"
                    android:layout_width="130dp"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="Cellular GSM SMS"
                    android:textColor="#CF6EFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvHook" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= SMS KEYWORD ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardKeyword"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#0D1729"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardEngine">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvKeywordHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚿  SMS TRIGGER KEYWORD"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btnEditKeyword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Keyword"
                    android:textColor="#D174FF"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvKeywordHeading" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardKeywordInside"
                    android:layout_width="0dp"
                    android:layout_height="95dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="#030817"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvKeywordHeading">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvCurrentKeywordLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Current Secret Keyword:"
                            android:textColor="#AAB7CA"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvKeyword"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="&quot;LOCATE&quot;"
                            android:textColor="#D980FF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvCurrentKeywordLabel" />

                        <TextView
                            android:id="@+id/tvExactMatch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓ Exact Match Active"
                            android:textColor="#00E5B0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvCase"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Case-Insensitive OK"
                            android:textColor="#8D9AAF"
                            android:textSize="10sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvExactMatch" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= LAST RESPONSE ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLastResponse"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#0D1729"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardKeyword">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvLastHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="◷  LAST BEACON RESPONSE"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLastTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No response yet"
                    android:textColor="#8997AC"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLastHeading" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardResponseInside"
                    android:layout_width="0dp"
                    android:layout_height="115dp"
                    android:layout_marginTop="15dp"
                    app:cardBackgroundColor="#030817"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLastHeading">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="14dp">

                        <TextView
                            android:id="@+id/tvRecipientLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Recipient Contact:"
                            android:textColor="#9BA9BE"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvRecipient"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="No Trusted Contact"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvRecipientLabel"
                            app:layout_constraintTop_toTopOf="@id/tvRecipientLabel" />

                        <TextView
                            android:id="@+id/tvCoordinateLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="Coordinates:"
                            android:textColor="#9BA9BE"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvRecipientLabel" />

                        <TextView
                            android:id="@+id/tvCoordinates"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="Not Available"
                            android:textColor="#00E5B0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvCoordinateLabel"
                            app:layout_constraintTop_toTopOf="@id/tvCoordinateLabel" />

                        <TextView
                            android:id="@+id/tvResponseStatusLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="13dp"
                            android:text="Status:"
                            android:textColor="#9BA9BE"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvCoordinateLabel" />

                        <TextView
                            android:id="@+id/tvResponseStatus"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:gravity="end"
                            android:text="● Ready"
                            android:textColor="#00E5B0"
                            android:textSize="10sp"
                            android:textStyle="bold"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@id/tvResponseStatusLabel"
                            app:layout_constraintTop_toTopOf="@id/tvResponseStatusLabel" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= HEALTH ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardHealth"
            android:layout_width="0dp"
            android:layout_height="170dp"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="#0D1729"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLastResponse">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvHealthHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ϟ  BEACON HEALTH TELEMETRY"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvHealthPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="READY"
                    android:textColor="#00E5B0"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvHealthHeading" />

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHealth1"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#030817"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@id/cardHealth2"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHealthHeading">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="GPS STATUS&#10;&#10;READY"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHealth2"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#030817"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@id/cardHealth3"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/cardHealth1"
                    app:layout_constraintTop_toTopOf="@id/cardHealth1">

                    <TextView
                        android:id="@+id/tvBatteryHealth"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="BATTERY&#10;&#10;--%"
                        android:textAlignment="center"
                        android:textColor="#00E5B0"
                        android:textSize="10sp"
                        android:textStyle="bold" />

                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardHealth3"
                    android:layout_width="0dp"
                    android:layout_height="80dp"
                    android:layout_marginStart="5dp"
                    app:cardBackgroundColor="#030817"
                    app:cardCornerRadius="13dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/cardHealth2"
                    app:layout_constraintTop_toTopOf="@id/cardHealth1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="SMS STATUS&#10;&#10;READY"
                        android:textAlignment="center"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= TEST BUTTON ================= -->

        <Button
            android:id="@+id/btnTestBeacon"
            android:layout_width="0dp"
            android:layout_height="58dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#951AFF"
            android:text="⚡  TEST BEACON AUTOMATIC RESPONSE"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardHealth" />


        <!-- ================= BOTTOM NAV ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardBottomNav"
            android:layout_width="0dp"
            android:layout_height="82dp"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#080E1A"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnTestBeacon">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◉&#10;Beacon"
                    android:textColor="#8D9AAF"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toStartOf="@id/navGps"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/navGps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌖&#10;GPS"
                    android:textColor="#8D9AAF"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toStartOf="@id/navSos"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/navHome" />

                <TextView
                    android:id="@+id/navSos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="!&#10;SOS"
                    android:textColor="#FF4565"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toStartOf="@id/navCircle"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/navGps" />

                <TextView
                    android:id="@+id/navCircle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="♙&#10;Circle"
                    android:textColor="#8D9AAF"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toStartOf="@id/navLogs"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/navSos" />

                <TextView
                    android:id="@+id/navLogs"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌁&#10;Logs"
                    android:textColor="#8D9AAF"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toStartOf="@id/navScreens"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/navCircle" />

                <TextView
                    android:id="@+id/navScreens"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="▦&#10;Screens"
                    android:textColor="#D478FF"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@id/navLogs" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>