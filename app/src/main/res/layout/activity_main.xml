<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050A12">

    <!-- HEADER -->

    <TextView
        android:id="@+id/tvLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BEACON"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Emergency Safety System"
        android:textColor="#7C899B"
        android:textSize="13sp"
        android:layout_marginTop="5dp"
        app:layout_constraintStart_toStartOf="@id/tvLogo"
        app:layout_constraintTop_toBottomOf="@id/tvLogo"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="● ONLINE"
        android:textColor="#35F28B"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="#123526"
        android:padding="8dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvLogo"/>

    <!-- STATUS CARD -->

    <androidx.cardview.widget.CardView
        android:id="@+id/statusCard"
        android:layout_width="0dp"
        android:layout_height="155dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="#0D1623"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvReady"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● BEACON READY"
                android:textColor="#35F28B"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                android:id="@+id/tvGpsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPS"
                android:textColor="#6F7D90"
                android:textSize="11sp"
                android:layout_marginStart="20dp"
                android:layout_marginBottom="42dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvGps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                app:layout_constraintStart_toStartOf="@id/tvGpsLabel"
                app:layout_constraintTop_toBottomOf="@id/tvGpsLabel"/>

            <TextView
                android:id="@+id/tvSmsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SMS"
                android:textColor="#6F7D90"
                android:textSize="11sp"
                android:layout_marginStart="115dp"
                android:layout_marginBottom="42dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvSms"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="READY"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                app:layout_constraintStart_toStartOf="@id/tvSmsLabel"
                app:layout_constraintTop_toBottomOf="@id/tvSmsLabel"/>

            <TextView
                android:id="@+id/tvBatteryLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BATTERY"
                android:textColor="#6F7D90"
                android:textSize="11sp"
                android:layout_marginStart="215dp"
                android:layout_marginBottom="42dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>

            <TextView
                android:id="@+id/tvBattery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="87%"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="5dp"
                app:layout_constraintStart_toStartOf="@id/tvBatteryLabel"
                app:layout_constraintTop_toBottomOf="@id/tvBatteryLabel"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- EMERGENCY CARD -->

    <androidx.cardview.widget.CardView
        android:id="@+id/emergencyCard"
        android:layout_width="0dp"
        android:layout_height="280dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="18dp"
        app:cardBackgroundColor="#280710"
        app:cardCornerRadius="24dp"
        app:layout_constraintTop_toBottomOf="@id/statusCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvEmergency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EMERGENCY"
                android:textColor="#FF5268"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginStart="22dp"
                android:layout_marginTop="20dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

            <Button
                android:id="@+id/btnSOS"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:text="SOS"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold"
                android:backgroundTint="#FF1744"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvHold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HOLD 3 SEC"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="27dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/tvInstruction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Press and hold to activate emergency beacon"
                android:textColor="#7C899B"
                android:textSize="10sp"
                android:layout_marginBottom="9dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

    <!-- GPS CARD -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardGPS"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="20dp"
        app:cardBackgroundColor="#0D1623"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toBottomOf="@id/emergencyCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/cardCircle">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="GPS&#10;Live Location"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </androidx.cardview.widget.CardView>

    <!-- CIRCLE CARD -->

    <androidx.cardview.widget.CardView
        android:id="@+id/cardCircle"
        android:layout_width="0dp"
        android:layout_height="78dp"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="20dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="#0D1623"
        app:cardCornerRadius="18dp"
        app:layout_constraintTop_toTopOf="@id/cardGPS"
        app:layout_constraintStart_toEndOf="@id/cardGPS"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="CIRCLE&#10;Trusted Contacts"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

    </androidx.cardview.widget.CardView>

    <!-- LAST LOCATION -->

    <TextView
        android:id="@+id/tvLastLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Last location  •  Just now"
        android:textColor="#718095"
        android:textSize="11sp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="22dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardGPS"/>

    <!-- BOTTOM NAVIGATION -->

    <TextView
        android:id="@+id/navHome"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="HOME"
        android:textColor="#A86BFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/navCircle"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/navCircle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CIRCLE"
        android:textColor="#A86BFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toEndOf="@id/navHome"
        app:layout_constraintEnd_toStartOf="@id/navLogs"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/navLogs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOGS"
        android:textColor="#A86BFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="20dp"
        app:layout_constraintStart_toEndOf="@id/navCircle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>