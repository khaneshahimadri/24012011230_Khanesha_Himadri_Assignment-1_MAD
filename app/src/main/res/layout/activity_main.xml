<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050812"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="18dp">


        <!-- ================= HEADER ================= -->

        <TextView
            android:id="@+id/tvBeaconTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="BEACON"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="● ONLINE"
            android:textColor="#20E6A4"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvBeaconTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvBeaconTitle" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Emergency Location System"
            android:textColor="#8C96AA"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tvBeaconTitle"
            app:layout_constraintTop_toBottomOf="@id/tvBeaconTitle" />


        <!-- ================= ACTIVE CARD ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardActive"
            android:layout_width="0dp"
            android:layout_height="220dp"
            android:layout_marginTop="25dp"
            app:cardBackgroundColor="#0C1324"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvActiveTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEACON ACTIVE &amp; LISTENING"
                    android:textColor="#00F5C4"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvActiveInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="3dp"
                    android:text="Keyword &quot;LOCATE&quot; triggers instant GPS coordinates reply over cellular SMS."
                    android:textColor="#C4CAD6"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvActiveTitle" />


                <!-- GPS -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardGPS"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#09101D"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@id/cardSms"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvActiveInfo">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="9dp">

                        <TextView
                            android:id="@+id/tvGpsTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="3D FIX"
                            android:textColor="#00E7B3"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvGps"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Searching"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvGpsTop" />

                        <TextView
                            android:id="@+id/tvGpsAccuracy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="± -- m"
                            android:textColor="#8791A5"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvGps" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>


                <!-- SMS -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSms"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#09101D"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@id/cardSignal"
                    app:layout_constraintStart_toEndOf="@id/cardGPS"
                    app:layout_constraintTop_toTopOf="@id/cardGPS">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="9dp">

                        <TextView
                            android:id="@+id/tvSmsTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY"
                            android:textColor="#C98CFF"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSms"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="SMS Ready"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSmsTop" />

                        <TextView
                            android:id="@+id/tvSmsBottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Cellular"
                            android:textColor="#8791A5"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSms" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>


                <!-- SIGNAL -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSignal"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginEnd="5dp"
                    app:cardBackgroundColor="#09101D"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toStartOf="@id/cardBattery"
                    app:layout_constraintStart_toEndOf="@id/cardSms"
                    app:layout_constraintTop_toTopOf="@id/cardGPS">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="9dp">

                        <TextView
                            android:id="@+id/tvSignalTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="READY"
                            android:textColor="#63B6FF"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvSignalValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="Signal"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSignalTop" />

                        <TextView
                            android:id="@+id/tvSignalBottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Cellular"
                            android:textColor="#8791A5"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvSignalValue" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>


                <!-- BATTERY -->

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardBattery"
                    android:layout_width="0dp"
                    android:layout_height="90dp"
                    android:layout_marginStart="5dp"
                    app:cardBackgroundColor="#09101D"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cardSignal"
                    app:layout_constraintTop_toTopOf="@id/cardGPS">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="9dp">

                        <TextView
                            android:id="@+id/tvBatteryTop"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="BATTERY"
                            android:textColor="#00E7B3"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/tvBattery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="9dp"
                            android:text="--%"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvBatteryTop" />

                        <TextView
                            android:id="@+id/tvBatteryBottom"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Optimized"
                            android:textColor="#8791A5"
                            android:textSize="8sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tvBattery" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= SOS CARD ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardSos"
            android:layout_width="0dp"
            android:layout_height="340dp"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#240910"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardActive">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvEmergency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠ EMERGENCY SOS DISPATCH"
                    android:textColor="#FF6C7D"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvOfflineReady"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_offline_ready"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="OFFLINE READY"
                    android:textColor="#FF9AA8"
                    android:textSize="8sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/btnSOS"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_marginTop="38dp"
                    android:background="@drawable/bg_sos_button"
                    android:gravity="center"
                    android:text="SOS\nHOLD 3 SEC"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvEmergency" />

                <TextView
                    android:id="@+id/tvHold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="3s REMAINING"
                    android:textColor="#FF536B"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btnSOS" />

                <TextView
                    android:id="@+id/tvSosInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="Press and hold for 3 seconds to broadcast your instant GPS coordinates to your Trusted Circle."
                    android:textColor="#B0B6C5"
                    android:textSize="11sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvHold" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= TEST BEACON ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTestBeacon"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="7dp"
            app:cardBackgroundColor="#10172A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@id/cardZeroInternet"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardSos">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvTestIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#3C256F"
                    android:gravity="center"
                    android:text="▷"
                    android:textColor="#C98CFF"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTestArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#708098"
                    android:textSize="28sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvTestIcon" />

                <TextView
                    android:id="@+id/tvTestTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Test Beacon"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTestIcon" />

                <TextView
                    android:id="@+id/tvTestSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Emulate SMS LOCATE"
                    android:textColor="#8B95AA"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvTestTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= ZERO INTERNET ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardZeroInternet"
            android:layout_width="0dp"
            android:layout_height="125dp"
            android:layout_marginStart="7dp"
            app:cardBackgroundColor="#181221"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/cardTestBeacon"
            app:layout_constraintTop_toTopOf="@id/cardTestBeacon">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvOfflineIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="#5B381B"
                    android:gravity="center"
                    android:text="⌁"
                    android:textColor="#FFC13D"
                    android:textSize="22sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvOfflineArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#708098"
                    android:textSize="28sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvOfflineIcon" />

                <TextView
                    android:id="@+id/tvOfflineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Zero Internet"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOfflineIcon" />

                <TextView
                    android:id="@+id/tvOfflineSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="100% Offline via SMS"
                    android:textColor="#8B95AA"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvOfflineTitle" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= TRUSTED CONTACT ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardCircle"
            android:layout_width="0dp"
            android:layout_height="90dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#0C1324"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTestBeacon">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">

                <TextView
                    android:id="@+id/tvContactAvatar"
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="#FF7A00"
                    android:gravity="center"
                    android:text="TC"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvContactName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:text="No Trusted Contact"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toEndOf="@id/tvContactAvatar"
                    app:layout_constraintTop_toTopOf="@id/tvContactAvatar" />

                <TextView
                    android:id="@+id/tvPrimary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="#5A3D0A"
                    android:paddingStart="7dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="2dp"
                    android:text="PRIMARY"
                    android:textColor="#FFD553"
                    android:textSize="7sp"
                    app:layout_constraintBottom_toBottomOf="@id/tvContactName"
                    app:layout_constraintStart_toEndOf="@id/tvContactName"
                    app:layout_constraintTop_toTopOf="@id/tvContactName" />

                <TextView
                    android:id="@+id/tvContactNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:layout_marginTop="7dp"
                    android:text="Tap Circle to add contact"
                    android:textColor="#8B95AA"
                    android:textSize="10sp"
                    app:layout_constraintStart_toEndOf="@id/tvContactAvatar"
                    app:layout_constraintTop_toBottomOf="@id/tvContactName" />

                <TextView
                    android:id="@+id/tvCircleOpen"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Circle  ›"
                    android:textColor="#C36DFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ================= BOTTOM NAV ================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardBottomNavigation"
            android:layout_width="0dp"
            android:layout_height="75dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="15dp"
            app:cardBackgroundColor="#080E1B"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardCircle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TextView
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⌁\nBeacon"
                    android:textColor="#C98CFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toStartOf="@id/navGps"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/navGps"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="◎\nGPS"
                    android:textColor="#8B95AA"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/navSos"
                    app:layout_constraintStart_toEndOf="@id/navHome" />

                <TextView
                    android:id="@+id/navSos"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="⚠\nSOS"
                    android:textColor="#FF526C"
                    android:textSize="14sp"
                    app:layout_constraintEnd_toStartOf="@id/navCircle"
                    app:layout_constraintStart_toEndOf="@id/navGps" />

                <TextView
                    android:id="@+id/navCircle"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="♙\nCircle"
