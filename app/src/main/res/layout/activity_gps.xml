<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050812"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingTop="20dp"
        android:paddingEnd="18dp"
        android:paddingBottom="25dp">


        <!-- ============================================= -->
        <!-- HEADER -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tvBack"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:gravity="center"
            android:text="←"
            android:textColor="#9FB4D8"
            android:textSize="27sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/tvGpsTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="Tactical GPS Telemetry"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/tvBack"
            app:layout_constraintEnd_toStartOf="@id/btnRefresh"
            app:layout_constraintStart_toEndOf="@id/tvBack"
            app:layout_constraintTop_toTopOf="@id/tvBack" />


        <Button
            android:id="@+id/btnRefresh"
            android:layout_width="82dp"
            android:layout_height="50dp"
            android:backgroundTint="#101A2D"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:text="↻ Refresh"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:cornerRadius="15dp"
            app:layout_constraintBottom_toBottomOf="@id/tvBack"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvBack" />


        <TextView
            android:id="@+id/tvGpsSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="46dp"
            android:layout_marginTop="3dp"
            android:text="Hardware GNSS Satellite Fix &amp; Coordinates"
            android:textColor="#8B96AA"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBack" />


        <!-- ============================================= -->
        <!-- GPS RADAR CARD -->
        <!-- ============================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/gpsStatusCard"
            android:layout_width="0dp"
            android:layout_height="205dp"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#07101D"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvGpsSubtitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="14dp">


                <!-- GPS FIX -->

                <TextView
                    android:id="@+id/tvGpsStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#03120F"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="GNSS: SEARCHING"
                    android:textColor="#00E8A8"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <!-- GPS TYPE -->

                <TextView
                    android:id="@+id/tvSatelliteStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="#08101D"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="GPS ACTIVE"
                    android:textColor="#B9D5FF"
                    android:textSize="8sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <!-- RADAR OUTER -->

                <TextView
                    android:id="@+id/radarOuter"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:background="@drawable/bg_gps_radar"
                    android:gravity="center"
                    android:text=""
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <!-- LOCATION DOT -->

                <TextView
                    android:id="@+id/tvLocationDot"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:background="@drawable/bg_location_dot"
                    android:gravity="center"
                    android:text="●"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    app:layout_constraintBottom_toBottomOf="@id/radarOuter"
                    app:layout_constraintEnd_toEndOf="@id/radarOuter"
                    app:layout_constraintStart_toStartOf="@id/radarOuter"
                    app:layout_constraintTop_toTopOf="@id/radarOuter" />


                <TextView
                    android:id="@+id/tvBeaconLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:layout_marginTop="8dp"
                    android:background="#27080E"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="BEACON LOCATION"
                    android:textColor="#FFFFFF"
                    android:textSize="7sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/radarOuter"
                    app:layout_constraintStart_toStartOf="@id/radarOuter"
                    app:layout_constraintTop_toBottomOf="@id/tvLocationDot" />


                <TextView
                    android:id="@+id/tvRadarAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="#08101D"
                    android:gravity="center"
                    android:paddingStart="9dp"
                    android:paddingEnd="9dp"
                    android:text="ACCURACY: --"
                    android:textColor="#B9C6DD"
                    android:textSize="8sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ============================================= -->
        <!-- LATITUDE CARD -->
        <!-- ============================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLatitude"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="6dp"
            app:cardBackgroundColor="#0B1424"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@id/cardLongitude"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/gpsStatusCard">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tvLatitudeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LATITUDE"
                    android:textColor="#8E9AB0"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLatitude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="--.------°"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLatitudeLabel" />

                <TextView
                    android:id="@+id/tvLatitudeDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Waiting for GPS"
                    android:textColor="#66758F"
                    android:textSize="8sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLatitude" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ============================================= -->
        <!-- LONGITUDE CARD -->
        <!-- ============================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardLongitude"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:layout_marginStart="6dp"
            app:cardBackgroundColor="#0B1424"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/cardLatitude"
            app:layout_constraintTop_toTopOf="@id/cardLatitude">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="15dp">

                <TextView
                    android:id="@+id/tvLongitudeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LONGITUDE"
                    android:textColor="#8E9AB0"
                    android:textSize="9sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvLongitude"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="--.------°"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLongitudeLabel" />

                <TextView
                    android:id="@+id/tvLongitudeDirection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Waiting for GPS"
                    android:textColor="#66758F"
                    android:textSize="8sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLongitude" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ============================================= -->
        <!-- OLD ID FOR COMPATIBILITY -->
        <!-- ============================================= -->

        <TextView
            android:id="@+id/tvCoordinatesTitle"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:ignore="MissingConstraints" />

        <androidx.cardview.widget.CardView
            android:id="@+id/coordinatesCard"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvCoordinates"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:visibility="gone" />

        </androidx.cardview.widget.CardView>


        <!-- ============================================= -->
        <!-- TELEMETRY CARD -->
        <!-- ============================================= -->

        <androidx.cardview.widget.CardView
            android:id="@+id/cardTelemetry"
            android:layout_width="0dp"
            android:layout_height="205dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#0B1424"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardLatitude">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp">


                <!-- ACCURACY -->

                <TextView
                    android:id="@+id/tvAccuracyLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Estimated Accuracy"
                    android:textColor="#9AA6BB"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvAccuracy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="± -- meters"
                    android:textColor="#00E8A8"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />


                <View
                    android:id="@+id/divider1"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:background="#1A2940"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAccuracyLabel" />


                <!-- PROVIDER -->

                <TextView
                    android:id="@+id/tvProviderLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Location Provider"
                    android:textColor="#9AA6BB"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider1" />

                <TextView
                    android:id="@+id/tvProvider"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GPS"
                    android:textColor="#D7E1F4"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvProviderLabel" />


                <View
                    android:id="@+id/divider2"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:background="#1A2940"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvProviderLabel" />


                <!-- ALTITUDE -->

                <TextView
                    android:id="@+id/tvAltitudeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Altitude"
                    android:textColor="#9AA6BB"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider2" />

                <TextView
                    android:id="@+id/tvAltitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- meters"
                    android:textColor="#D7E1F4"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvAltitudeLabel" />


                <View
                    android:id="@+id/divider3"
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="13dp"
                    android:background="#1A2940"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvAltitudeLabel" />


                <!-- LAST UPDATE -->

                <TextView
                    android:id="@+id/tvLastPollingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="Last GPS Update"
                    android:textColor="#9AA6BB"
                    android:textSize="10sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/divider3" />

                <TextView
                    android:id="@+id/tvLocationTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Waiting..."
                    android:textColor="#D7E1F4"
                    android:textSize="10sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvLastPollingLabel" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <!-- ============================================= -->
        <!-- COPY BUTTON -->
        <!-- ============================================= -->

        <Button
            android:id="@+id/btnCopyCoordinates"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#17243A"
            android:minHeight="0dp"
            android:text="Copy Coordinates"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toStartOf="@id/btnOpenMaps"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardTelemetry" />


        <!-- ============================================= -->
        <!-- MAP BUTTON -->
        <!-- ============================================= -->

        <Button
            android:id="@+id/btnOpenMaps"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginStart="6dp"
            android:backgroundTint="#511393"
            android:minHeight="0dp"
            android:text="Open Web Map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            app:cornerRadius="14dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnCopyCoordinates"
            app:layout_constraintTop_toTopOf="@id/btnCopyCoordinates" />


        <!-- Old information ID -->

        <TextView
            android:id="@+id/tvInformation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="GPS coordinates can work without mobile internet."
            android:textColor="#66758F"
            android:textSize="9sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnCopyCoordinates" />


    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>